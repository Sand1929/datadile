# Optional. Only required for premium server-backed features.
# api_key_env: DATADILE_API_KEY

default_data_source: main

data_sources:
  main:
    type: postgresql
    host: localhost
    port: 5432
    user: myuser
    database: mydb
    password_env: DATABASE_PASSWORD

# Premium server-backed data source example:
# data_sources:
#   main:
#     id: ds_abc123
